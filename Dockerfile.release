# ===========================================================================
# new-api 发布镜像：含前端 + 后端
# 专为 GitHub Actions 构建设计，在容器内完整构建前端，不依赖本地环境。
#
# 适配上游前端目录重组（web/default → web/）与 relaykit 子模块。
# ===========================================================================

# ---------- Stage 1: 构建前端 ----------
FROM oven/bun:1 AS builder-web

WORKDIR /build/web
COPY web/package.json web/bun.lock ./
RUN bun install --frozen-lockfile
COPY ./web ./
COPY ./VERSION /build/VERSION
RUN DISABLE_ESLINT_PLUGIN='true' VITE_REACT_APP_VERSION=$(cat /build/VERSION) bun run build

# ---------- Stage 2: 构建后端 ----------
FROM golang:1.26.1-alpine AS builder-go

ENV GO111MODULE=on CGO_ENABLED=0 GOWORK=off
ARG TARGETOS
ARG TARGETARCH
ENV GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64}
ENV GOEXPERIMENT=greenteagc

WORKDIR /build

ADD go.mod go.sum ./
# relaykit 是通过 replace 引用的本地子模块；go mod download 解析主模块图时
# 需要它的 go.mod 存在。
ADD relaykit/go.mod ./relaykit/go.mod
RUN go mod download

COPY . .
COPY --from=builder-web /build/web/dist ./web/dist
RUN go build -ldflags "-s -w -X 'github.com/QuantumNous/new-api/common.Version=$(cat VERSION)'" -o new-api

# ---------- Stage 3: 运行时镜像 ----------
FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata wget \
    && rm -rf /var/lib/apt/lists/* \
    && update-ca-certificates

COPY --from=builder-go /build/new-api /new-api
COPY LICENSE NOTICE THIRD-PARTY-LICENSES.md /licenses/
EXPOSE 3000
WORKDIR /data
ENTRYPOINT ["/new-api"]
